{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcom.org/schemas/item.schema.json",
  "title": "AgentCom canonical item",
  "type": "object",
  "required": ["slug", "kind", "title", "summary", "sources"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "kind": {"enum": ["protocol", "platform", "guide", "resource"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "title", "authority", "last_verified"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "authority": {"enum": ["primary", "secondary"]},
          "last_verified": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
