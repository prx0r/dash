{"description": "Feed live outcomes (tiers 0-3 per LIVE_LEARNING_LOOP) back: transition campaign per state machine (PROVEN/MUTATE/KILLED), extract reusable priors (supplier success, buyer-selector rate, return rate, gap patterns) for future compiles. Killed campaigns are preserved with reason.", "deterministic": true, "inputs": [{"from": "campaign + live metrics", "name": "outcome"}, {"from": "tier definitions (proxy/intent/transaction/resolution)", "name": "tiers", "required": false}], "op_id": "distill-refine", "outputs": [{"name": "transition", "to": "{to_state: PROVEN|MUTATE|KILLED, reason, evidence_refs}"}, {"name": "priors", "to": "{supplier_success_by_class, buyer_selector_by_component, return_rate_by_complexity, gap_patterns} (nulls where unmeasured)"}], "params": {"resolution_is_fitness": true, "preserve_killed": true}, "side_effect": 1, "sources": ["LIVE_LEARNING_LOOP.md", "CAMPAIGN_STATE_MACHINE.md", "rubric/RUBRIC_B_STATISTICAL_GATE.md"], "version": "v1"}